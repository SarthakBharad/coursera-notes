{
  "name": "coursera-notes",
  "version": "1.0.0",
  "private": true,
  "description": "Sarthak's Coursera Notes: a static site for reading my Coursera study notes.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "media": "tsx scripts/copy-media.ts",
    "check:content": "tsx scripts/check-content.ts",
    "predev": "pnpm media",
    "dev": "next dev",
    "prebuild": "pnpm media",
    "build": "next build",
    "start": "npx serve@14.2.4 out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "github-slugger": "2.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hast-util-to-string": "3.0.1",
    "image-size": "2.0.4",
    "katex": "0.16.47",
    "minisearch": "7.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-pretty-code": "0.14.5",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
